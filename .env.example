#############################################
# Dataset / Test Data
#############################################
# Which dataset folder under src/testdata/ to use
# Example structure:
#   src/testdata/default/users.json
#   src/testdata/default/products.json
DATASET=default


#############################################
# Execution Context (Matrix)
#############################################
# PLATFORM:
#   web       -> Web UI
#   android   -> Android Mobile UI (Appium)
#   ios       -> iOS Mobile UI (Appium)
PLATFORM=web

# VIEWPORT (only applies when PLATFORM=web)
#   desktop     -> desktop layout
#   responsive  -> mobile-like viewport (small screen + touch)
VIEWPORT=responsive

# DRIVER:
#   playwright  -> Web automation
#   appium      -> Mobile automation
DRIVER=playwright


#############################################
# Web Configuration (Playwright)
#############################################
BASE_URL=https://www.saucedemo.com

# Show browser UI (headed) vs run in headless mode
# true  -> headless
# false -> visible browser window
HEADLESS=true

# Optional: slow down actions to see what happens (ms)
# Example: 250
# SLOWMO=250


#############################################
# Logging / Telemetry
#############################################
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info


#############################################
# AI Observability Provider (post-run analysis)
#############################################
# AI_PROVIDER:
#   ollama -> local inference (recommended for cost)
#   openai -> cloud validation (optional)
AI_PROVIDER=ollama

# Example local model (Ollama)
AI_MODEL=llama3


#############################################
# Appium Server
#############################################
APPIUM_HOST=localhost
APPIUM_PORT=4723

#############################################
# Mobile App Under Test (Appium)
#############################################
# Choose which capability profile to use (filename without .json)
CAP_PROFILE=galaxy_s25_ultra

# Recommended: use relative paths so it works on any machine/CI.
# The adapter should resolve them to absolute paths using process.cwd().
ANDROID_APP_PATH=assets/apps/android/mda-2.2.0-25.apk
IOS_APP_PATH=assets/apps/ios/My Demo App.app

# If you prefer a single variable, you can keep this and set it per run:
# MOBILE_APP_PATH=assets/apps/android/mda-2.2.0-25.apk

# WDIO log level
WDIO_LOG_LEVEL=error